# ==============================================================================
# SNAPPRICE MX - VARIABLES DE ENTORNO (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVIDOR BACKEND (EXPRESS & IA) - PRIVADAS / NUNCA EXPUESTAS AL NAVEGADOR
# ------------------------------------------------------------------------------
# Clave de API de Google Gemini para valuación multimodal
GEMINI_API_KEY="AIzaSy..."

# Puerto del servidor (por defecto 3000)
PORT=3000

# Entorno de ejecución: development | production
NODE_ENV="development"

# URL base de la aplicación (inyectada automáticamente en Cloud Run)
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. CLIENTE FRONTEND (FIREBASE CLIENT CONFIG) - OPCIONAL / ANULACIÓN POR ENV
# Si estas variables están ausentes, la app cargará los valores de src/firebase-config.json
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY="AIzaSyBdG4PK68CLI6sGRPjyGhiptVbVt6ZDk44"
VITE_FIREBASE_AUTH_DOMAIN="tu-proyecto.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="tu-proyecto"
VITE_FIREBASE_STORAGE_BUCKET="tu-proyecto.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="637799288556"
VITE_FIREBASE_APP_ID="1:637799288556:web:9c92d703281fff3f891fc9"
